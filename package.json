{
  "name": "@keytd/dynamic-backend-client",
  "version": "1.0.4",
  "description": "JavaScript client for the Dynamic Backend API",
  "main": "index.js",
  "types": "types/index.d.ts",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "docs": "jsdoc -c jsdoc.json",
    "docs:serve": "http-server docs/ -o"
  },
  "keywords": [
    "api",
    "client",
    "blog",
    "dynamic",
    "tables",
    "javascript"
  ],
  "author": "Your Organization",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "jest": "^29.5.0",
    "@babel/core": "^7.22.5",
    "@babel/preset-env": "^7.22.5",
    "babel-jest": "^29.5.0",
    "jsdoc": "^4.0.2",
    "docdash": "^2.0.1",
    "http-server": "^14.1.1"
  },
  "jest": {
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "lib/**/*.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KeyTechAndDesign/dynamic-backend-client.git"
  },
  "bugs": {
    "url": "https://github.com/KeyTechAndDesign/dynamic-backend-client/issues"
  },
  "homepage": "https://github.com/KeyTechAndDesign/dynamic-backend-client#readme"
}
